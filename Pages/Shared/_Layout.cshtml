@using System.Security.Claims
@{
    var user = Context.User;

    var name = user?.FindFirst(ClaimTypes.Name)?.Value
            ?? user?.FindFirst("name")?.Value;

    var email = user?.FindFirst(ClaimTypes.Email)?.Value
             ?? user?.FindFirst("preferred_username")?.Value;

}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - eTimeTrial.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eTimeTrial.Web.styles.css" asp-append-version="true" />
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous"> *@
    @* <link href="https://fonts.googleapis.com/css2?family=Raleway&display=swap" rel="stylesheet"> *@
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"> *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script type='text/javascript' src='~/lib/knockout/knockout-latest.js'></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Roboto+Mono:wght@400;500;700&family=Raleway:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#111111">
</head>
<body>
    <div id="errorAlert" class="alert alert-danger d-none" role="alert"></div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    <img src="~/images/eTimeTrial.png" width="200" />
                </a>
                @if (user?.Identity?.IsAuthenticated ?? false)
                {
                    @*              <div class="user-badge">
                        <span class="user-name">@name</span>
                        <span class="user-email">@email</span>
                    </div> *@

                    @*  <div class="user-badge" title="@email">
    <span class="user-name">@name</span>
</div> *@
                    <span class="badge bg-primary">
                        @name
                    </span>


                }


                @*  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#LoadTeamsModal">Load Teams</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#SettingsModal">Settings</a>
                        </li>
                        
                        
                    </ul>
                    
                </div> *@
            </div>
        </nav>


        @*  <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container text-center">
                <a class="navbar-brand" asp-area="" asp-page="/Index">eTimeTrial.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                </div>
            </div>
        </nav> *@
    </header>
    
    <div class="container text-center ">

        <main role="main" class="pb-3" style="font-family:Raleway">
            @RenderBody()
        </main>
    </div>

    <script>
         function showError(message) {
            const alert = document.getElementById("errorAlert");
            alert.textContent = message;
            alert.classList.remove("d-none");

            // Auto-hide after 5 seconds (optional)
            setTimeout(() => {
                alert.classList.add("d-none");
            }, 5000);
        }

    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>